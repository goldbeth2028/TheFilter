{
  "name": "thefilter",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:extension": "node scripts/build-extension.mjs",
    "verify:extension": "node scripts/verify-extension.mjs",
    "simulator": "node scripts/build-simulator.mjs && node scripts/serve-simulator.mjs",
    "simulator:build": "node scripts/build-simulator.mjs",
    "simulator:serve": "node scripts/serve-simulator.mjs",
    "verify:simulator": "node scripts/verify-simulator.mjs",
    "verify:detector": "node scripts/verify-detector.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "preview": "node scripts/build-simulator.mjs && node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "playwright": "^1.62.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
