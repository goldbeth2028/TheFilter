{
  "expo": {
    "name": "The Filter",
    "slug": "thefilter",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "thefilter",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0E10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thefilter.app",
      "infoPlist": {
        "NSUserActivityTypes": [
          "INSendMessageIntent"
        ]
      }
    },
    "android": {
      "package": "com.thefilter.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0E10"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "./plugins/with-fmt-cxx17"
    ],
    "icon": "./assets/icon.png"
  }
}
