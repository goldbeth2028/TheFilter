{
  "manifest_version": 3,
  "name": "The Filter",
  "version": "0.1.0",
  "description": "Covers posts written to provoke, and strong claims with nothing to check them against. Scored on your device.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://reddit.com/*",
    "https://*.reddit.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://threads.net/*",
    "https://*.threads.net/*",
    "https://threads.com/*",
    "https://*.threads.com/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://bsky.app/*",
    "https://*.bsky.app/*",
    "https://mastodon.social/*",
    "https://*.mastodon.social/*",
    "https://news.ycombinator.com/*",
    "https://*.news.ycombinator.com/*",
    "https://lemmy.world/*",
    "https://*.lemmy.world/*",
    "https://tumblr.com/*",
    "https://*.tumblr.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "The Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://reddit.com/*",
        "https://*.reddit.com/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://threads.com/*",
        "https://*.threads.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://bsky.app/*",
        "https://*.bsky.app/*",
        "https://mastodon.social/*",
        "https://*.mastodon.social/*",
        "https://news.ycombinator.com/*",
        "https://*.news.ycombinator.com/*",
        "https://lemmy.world/*",
        "https://*.lemmy.world/*",
        "https://tumblr.com/*",
        "https://*.tumblr.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
